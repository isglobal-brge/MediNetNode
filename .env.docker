# ==============================================================================
# MediNet-Node Docker/Production Environment Variables
# ==============================================================================
# This file is used when running the Docker container
# Copy to .env.production and configure for your deployment
# ==============================================================================

# Django Core Settings
# Note: SECRET_KEY is auto-generated by entrypoint.sh and persisted in /usr/src/app/config/

# SECURITY: Set to False in production
DEBUG=False

# ALLOWED_HOSTS: Add all domains/IPs where this node will be accessed
# For federated learning, include:
# - Your server's public IP
# - Your domain name
# - Docker internal network IPs (172.17.0.1, etc.)
# - Any reverse proxy/load balancer IPs
ALLOWED_HOSTS=localhost,127.0.0.1,172.17.0.1

# ==============================================================================
# Database Configuration (Production)
# ==============================================================================

# PostgreSQL example (recommended for production)
# DATABASE_URL=postgresql://medinet_user:secure_password@db:5432/medinet_db
# DATASETS_DATABASE_URL=postgresql://medinet_user:secure_password@db:5432/medinet_datasets

# MySQL example
# DATABASE_URL=mysql://medinet_user:secure_password@db:3306/medinet_db
# DATASETS_DATABASE_URL=mysql://medinet_user:secure_password@db:3306/medinet_datasets

# ==============================================================================
# Cache Configuration (Production)
# ==============================================================================

# Redis cache (recommended for production)
# REDIS_URL=redis://redis:6379/0

# ==============================================================================
# Security Settings
# ==============================================================================

# CSRF Trusted Origins (for production with HTTPS)
# Example: CSRF_TRUSTED_ORIGINS=https://medinet.hospital.com,https://nodo1.hospital.com
# CSRF_TRUSTED_ORIGINS=

# ==============================================================================
# MediNet v2 security flags (from the adversarial audit remediation)
# ==============================================================================
# Safe defaults; the values below are the DEPLOY posture. For local non-Docker
# development, DEBUG=True already relaxes the fail-closed guards.

# Flower transport (H5 — fail-closed). In Docker the Hub auto-generates TLS certs
# and sends the CA to the Node, so leave this FALSE and the channel uses TLS.
# Set true ONLY as a temporary bridge if you run without cert infra (and then
# restrict the Flower port to invited hospital IPs by firewall meanwhile).
FLOWER_ALLOW_INSECURE=false

# DP noise source. By DEFAULT the noise is drawn from a torch.Generator seeded
# with a 63-bit CSPRNG seed (`secrets`) — unpredictable/non-reproducible without
# the secret, so it is adequate for deployment with NO extra dependency.
# DP_SECURE_MODE=true enables Opacus's strict secure_mode, which needs the
# `torchcsprng` package — that project is UNMAINTAINED and incompatible with
# modern PyTorch (2.x), so leave this OFF unless you pin torch 1.8 on purpose.
# DP_SECURE_MODE=true

# Conservative per-job epsilon target used only if a dataset's privacy policy
# lookup fails during training (fail-closed cap). Default 1.0.
# DP_FALLBACK_TARGET_EPSILON=1.0

# Resource caps (OOM / decompression-bomb guards). Bytes. Defaults shown.
# DATASET_MAX_FILE_SIZE=2147483648      # 2 GiB on-disk dataset upload cap
# INFERENCE_MAX_UPLOAD_SIZE=52428800    # 50 MiB inference input cap

# Reverse-proxy IPs allowed to set X-Forwarded-For / X-Real-IP. Empty = no proxy
# trusted (client-supplied headers ignored — the safe default). Comma-separated.
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2

# ==============================================================================
# Static and Media Files
# ==============================================================================

# If using external storage (S3, CDN, etc.)
# STATIC_URL=https://cdn.example.com/static/
# MEDIA_URL=https://cdn.example.com/media/

# ==============================================================================
# Application Settings
# ==============================================================================

# Time zone
# TZ=Europe/Madrid

# Language
# LANGUAGE_CODE=en-us

# ==============================================================================
# Logging Level
# ==============================================================================

# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
